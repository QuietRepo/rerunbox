# RerunBox secrets  (installed to /etc/rerunbox/secrets.env, mode 0640 root:rerunbox)
#
# Never commit the real file. The installer creates it for you.

# Full RTMP/RTMPS ingest URL INCLUDING your stream key, e.g.
#   rtmp://live.restream.io/live/re_1234567_abcdef
#   rtmp://live.twitch.tv/app/live_123456789_abcdefg
#   rtmp://a.rtmp.youtube.com/live2/xxxx-xxxx-xxxx-xxxx
RTMP_URL=""

# Shared secret required by the webhook (header X-Webhook-Token).
WEBHOOK_TOKEN=""

# Optional: Discord webhook URL, used to announce each scheduled restart.
DISCORD_WEBHOOK_URL=""
